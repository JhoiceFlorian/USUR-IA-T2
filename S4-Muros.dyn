    {
      "ConcreteType": "DSRevitNodesUI.Categories, DSRevitNodesUI",
      "SelectedIndex": 502,
      "SelectedString": "OST_Walls",
      "Id": "45f57bea85354cbf9b92f4df876a36fe",
      "NodeType": "ExtensionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "5d170a65691342cca9267e6329dedd93",
          "Name": "Category",
          "Description": "The selected Category.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "All built-in categories."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Desenvolver los elementos de Dynamo a elementos nativos de Revit\r\nentrada = IN[0]\r\nif not isinstance(entrada, list):\r\n    entrada = [entrada]\r\nelementos = [UnwrapElement(e) for e in entrada]\r\n\r\nregistros = []\r\n\r\nfor el in elementos:\r\n    # Tipo de muro y su nombre\r\n    tipo = doc.GetElement(el.GetTypeId())\r\n    nombre_tipo = tipo.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM).AsString()\r\n\r\n    # Nivel base del muro\r\n    nivel_el = doc.GetElement(el.LevelId)\r\n    nivel = nivel_el.Name if nivel_el else None\r\n\r\n    registros.append({\r\n        \"Id\": el.Id.Value,\r\n        \"Nombre\": nombre_tipo,\r\n        \"Nivel\": nivel\r\n    })\r\n\r\n# Comillas simples por fuera porque el nombre incluye el símbolo \" (pulgadas)\r\nvalores_validos = ['Concrete 12\"', 'Concrete 18\"', 'Concrete 24\"']\r\n\r\nfor r in registros:\r\n    nombre = r[\"Nombre\"].strip() if r[\"Nombre\"] else \"\"\r\n    if nombre == \"\":\r\n        r[\"Estado\"] = \"Falta parámetro\"\r\n    elif nombre not in valores_validos:\r\n        r[\"Estado\"] = \"Fuera de estándar\"\r\n    else:\r\n        r[\"Estado\"] = \"OK\"\r\n\r\nencabezados = [\"Id\", \"Nombre\", \"Nivel\", \"Estado\"]\r\nfilas = [[r[\"Id\"], r[\"Nombre\"], r[\"Nivel\"], r[\"Estado\"]]\r\n         for r in registros]\r\n\r\nOUT = [encabezados] + filas",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "31dc7a84c540414fa8d5e4e5b9a6efb3",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "e730a1f395984b7e947eddffbd16b281",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "6b9e91a3fa1d4be3ac3bbce6b24a2f96",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
